<?xml version="1.0"?>
<robot name="tunnel_vehicle" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Frame: base_link at rear axle centre, projected to ground.
       x forward, y left, z up. All dimensions in metres. -->

  <xacro:property name="wheelbase"        value="3.0"/>
  <xacro:property name="track_width"      value="1.5"/>
  <xacro:property name="wheel_radius"     value="0.5"/>
  <xacro:property name="wheel_width"      value="0.3"/>
  <xacro:property name="rear_overhang"    value="1.0"/>
  <xacro:property name="front_overhang"   value="1.0"/>
  <xacro:property name="body_width"       value="1.4"/>
  <xacro:property name="body_top"         value="4.0"/>
  <xacro:property name="ground_clearance" value="0.4"/>
  <xacro:property name="max_steer"        value="0.20944"/>  <!-- 12 deg in rad -->

  <xacro:property name="body_length" value="${wheelbase + rear_overhang + front_overhang}"/>
  <xacro:property name="body_height" value="${body_top - ground_clearance}"/>
  <xacro:property name="body_cx"     value="${wheelbase/2.0 + (front_overhang - rear_overhang)/2.0}"/>
  <xacro:property name="body_cz"     value="${ground_clearance + body_height/2.0}"/>

  <xacro:property name="body_mass"  value="5000.0"/>
  <xacro:property name="wheel_mass" value="100.0"/>

  <material name="steel">  <color rgba="0.55 0.58 0.60 1"/></material>
  <material name="rubber"> <color rgba="0.15 0.15 0.15 1"/></material>

  <!-- Chassis -->
  <link name="base_link">
    <visual>
      <origin xyz="${body_cx} 0 ${body_cz}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
      <material name="steel"/>
    </visual>
    <collision>
      <origin xyz="${body_cx} 0 ${body_cz}" rpy="0 0 0"/>
      <geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry>
    </collision>
    <inertial>
      <!-- Centre of mass placed low, as on a real machine where the
           heavy powertrain sits under the cabin. -->
      <origin xyz="${body_cx} 0 1.0" rpy="0 0 0"/>
      <mass value="${body_mass}"/>
      <inertia
        ixx="${body_mass/12.0 * (body_width*body_width + body_height*body_height)}"
        iyy="${body_mass/12.0 * (body_length*body_length + body_height*body_height)}"
        izz="${body_mass/12.0 * (body_length*body_length + body_width*body_width)}"
        ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- Wheel macro. Cylinder axis rotated onto y. -->
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <material name="rubber"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="1.5707963 0 0"/>
        <mass value="${wheel_mass}"/>
        <inertia
          ixx="${wheel_mass/12.0 * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyy="${wheel_mass/12.0 * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          izz="${wheel_mass*wheel_radius*wheel_radius/2.0}"
          ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <!-- Rear wheels: driven, no steering. -->
  <xacro:wheel_link name="rear_left_wheel"/>
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="rear_left_wheel"/>
    <origin xyz="0 ${track_width/2.0} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:wheel_link name="rear_right_wheel"/>
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="rear_right_wheel"/>
    <origin xyz="0 ${-track_width/2.0} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front: a steering link between chassis and wheel, so the wheel
       can spin about y while the steer joint rotates about z. -->
  <xacro:macro name="steer_link" params="name">
    <link name="${name}">
      <inertial>
        <mass value="10.0"/>
        <inertia ixx="0.1" iyy="0.1" izz="0.1" ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:steer_link name="front_left_steer"/>
  <joint name="front_left_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="front_left_steer"/>
    <origin xyz="${wheelbase} ${track_width/2.0} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-max_steer}" upper="${max_steer}" effort="10000" velocity="1.0"/>
  </joint>

  <xacro:wheel_link name="front_left_wheel"/>
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="front_left_steer"/>
    <child  link="front_left_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <xacro:steer_link name="front_right_steer"/>
  <joint name="front_right_steer_joint" type="revolute">
    <parent link="base_link"/>
    <child  link="front_right_steer"/>
    <origin xyz="${wheelbase} ${-track_width/2.0} ${wheel_radius}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-max_steer}" upper="${max_steer}" effort="10000" velocity="1.0"/>
  </joint>

  <xacro:wheel_link name="front_right_wheel"/>
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="front_right_steer"/>
    <child  link="front_right_wheel"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system"
            name="gz::sim::systems::AckermannSteering">
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <kingpin_width>${track_width}</kingpin_width>
      <steering_limit>${max_steer}</steering_limit>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${track_width}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <min_velocity>-2.0</min_velocity>
      <max_velocity>5.0</max_velocity>
      <min_acceleration>-2.0</min_acceleration>
      <max_acceleration>2.0</max_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>
  </gazebo>

</robot>