<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="corridor">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="corridor_structure">
      <static>true</static>
    <link name="floor">
      <pose>75.0 0 -0.1 0 0 0</pose>
      <collision name="floor_collision">
        <geometry>
          <box><size>150.0 6.0 0.2</size></box>
        </geometry>
      </collision>
      <visual name="floor_visual">
        <geometry>
          <box><size>150.0 6.0 0.2</size></box>
        </geometry>
        <material>
          <ambient>0.4 0.4 0.4 1</ambient>
          <diffuse>0.4 0.4 0.4 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="wall_left">
      <pose>75.0 3.1 3.0 0 0 0</pose>
      <collision name="wall_left_collision">
        <geometry>
          <box><size>150.0 0.2 6.0</size></box>
        </geometry>
      </collision>
      <visual name="wall_left_visual">
        <geometry>
          <box><size>150.0 0.2 6.0</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.55 1</ambient>
          <diffuse>0.6 0.6 0.55 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="wall_right">
      <pose>75.0 -3.1 3.0 0 0 0</pose>
      <collision name="wall_right_collision">
        <geometry>
          <box><size>150.0 0.2 6.0</size></box>
        </geometry>
      </collision>
      <visual name="wall_right_visual">
        <geometry>
          <box><size>150.0 0.2 6.0</size></box>
        </geometry>
        <material>
          <ambient>0.6 0.6 0.55 1</ambient>
          <diffuse>0.6 0.6 0.55 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="ceiling">
      <pose>75.0 0 6.1 0 0 0</pose>
      <collision name="ceiling_collision">
        <geometry>
          <box><size>150.0 6.0 0.2</size></box>
        </geometry>
      </collision>
      <visual name="ceiling_visual">
        <geometry>
          <box><size>150.0 6.0 0.2</size></box>
        </geometry>
        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.5 0.5 0.5 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="end_near">
      <pose>-0.1 0 3.0 0 0 0</pose>
      <collision name="end_near_collision">
        <geometry>
          <box><size>0.2 6.0 6.0</size></box>
        </geometry>
      </collision>
      <visual name="end_near_visual">
        <geometry>
          <box><size>0.2 6.0 6.0</size></box>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.45 1</ambient>
          <diffuse>0.45 0.45 0.45 1</diffuse>
        </material>
      </visual>
    </link>
    <link name="end_far">
      <pose>150.1 0 3.0 0 0 0</pose>
      <collision name="end_far_collision">
        <geometry>
          <box><size>0.2 6.0 6.0</size></box>
        </geometry>
      </collision>
      <visual name="end_far_visual">
        <geometry>
          <box><size>0.2 6.0 6.0</size></box>
        </geometry>
        <material>
          <ambient>0.45 0.45 0.45 1</ambient>
          <diffuse>0.45 0.45 0.45 1</diffuse>
        </material>
      </visual>
    </link>
    </model>

  </world>
</sdf>
